  forest_mist: 'linear-gradient(180deg, #c8d5c8 0%, #8faa8f 40%, #3d5a3d 100%)',
  night_sky: 'linear-gradient(180deg, #0a0a1a 0%, #0d0d2b 50%, #1a0a2a 100%)',
  golden_hour: 'linear-gradient(180deg, #2a1a0a 0%, #3d2010 50%, #1a0d05 100%)',
  ocean_deep: 'linear-gradient(180deg, #0a1a2a 0%, #0d2040 50%, #051015 100%)',
  arctic: 'linear-gradient(180deg, #e8f0f8 0%, #c0d0e0 50%, #8090a0 100%)',
};

